# ==========================================
# MLOps Build Agent Suite Configuration
# ==========================================

# Execution Mode: "local" (standalone, zero-cloud) or "azure" (cloud integrated)
APP_MODE=local

# Server Configuration
PORT=8000
HOST=0.0.0.0

# LangChain & LangSmith Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=mlops-build-agent-suite

# Microsoft Azure Configuration (Required if APP_MODE=azure)
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_ID=your_azure_client_id
AZURE_SUBSCRIPTION_ID=your_azure_subscription_id
AZURE_RESOURCE_GROUP=mlops-rg
AZURE_STORAGE_ACCOUNT=mlopsstorage
AZURE_STORAGE_CONTAINER=datasets
AZURE_CONTAINER_REGISTRY=myregistry.azurecr.io
AZURE_OPENAI_ENDPOINT=https://your-aoai-instance.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
