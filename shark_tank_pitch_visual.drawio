          <mxGeometry x="20" y="265" width="24" height="24" as="geometry"/>
        </mxCell>

        <!-- Del 13: Observability & LangSmith Hub -->
        <mxCell id="d_13" value="&lt;b&gt;Continuous Drift &amp;amp; LangSmith Observability&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;color:#475569;'&gt;Real-time p50/p95/p99 latency distributions, feature drift alerts, 1-click retrain action, and full prompt tree telemetry in LangSmith.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;fontColor=#1e293b;arcSize=8;" vertex="1" parent="col_delivery">
