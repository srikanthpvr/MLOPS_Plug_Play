        <!-- Del 15: The Shark Tank Value Proposition -->
        <mxCell id="d_15" value="&lt;b&gt;The Shark Tank Investment Proposition&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;color:#475569;'&gt;$15.4B Exploding TAM | Enterprise SaaS ($10k/mo per org) | Fully Tested &amp;amp; Verified: 5/5 Automated Tests Passing.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;fontColor=#1e293b;arcSize=8;" vertex="1" parent="col_delivery">
