        <!-- Del 14: 60-Second Time to Production -->
        <mxCell id="d_14" value="&lt;b&gt;10x Speedup: 6 Weeks to 60 Seconds&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;color:#475569;'&gt;One-click launcher (run_mlops_platform.bat). Runs locally with zero cloud dependencies or connects to Microsoft Azure in 30 seconds.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;fontColor=#1e293b;arcSize=8;" vertex="1" parent="col_delivery">
