          <mxGeometry x="20" y="690" width="24" height="24" as="geometry"/>
        </mxCell>


        <!-- COLUMN 3: WHAT WE ARE DELIVERING -->
        <mxCell id="col_delivery" value="3. WHAT WE ARE DELIVERING: PLUG &amp;amp; PLAY VALUE ARTIFACTS" style="swimlane;html=1;startSize=32;rounded=1;arcSize=6;fillColor=#f0fdf4;strokeColor=#86efac;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="1160" y="50" width="490" height="980" as="geometry"/>
        </mxCell>

        <!-- Delivery Banner -->
        <mxCell id="card_del_banner" value="&lt;b style='font-size:14px;color:#059669;'&gt;Enterprise-Grade Open Source Repository&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;color:#065f46;'&gt;Live on GitHub: github.com/srikanthpvr/MLOPS_Plug_Play&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a7f3d0;fontFamily=Helvetica;fontSize=12;arcSize=8;" vertex="1" parent="col_delivery">
