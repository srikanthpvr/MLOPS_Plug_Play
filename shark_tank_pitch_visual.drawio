<mxfile host="app.diagrams.net">
  <diagram id="shark-tank-pitch" name="Shark-Tank-Pitch-Visual">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- COLUMN 1: THE CURRENT PROBLEM STATEMENT -->
        <mxCell id="col_problem" value="1. THE CURRENT PROBLEM STATEMENT: THE $100B AI CRISIS" style="swimlane;html=1;startSize=32;rounded=1;arcSize=6;fillColor=#fef2f2;strokeColor=#f87171;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#991b1b;" vertex="1" parent="1">
          <mxGeometry x="50" y="50" width="480" height="980" as="geometry"/>
        </mxCell>

        <!-- Stat Card -->
        <mxCell id="card_stat" value="&lt;b style='font-size:15px;color:#dc2626;'&gt;87% of Enterprise AI Models DIE&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;color:#7f1d1d;'&gt;Billions invested in data science teams, yet only 13% ever reach continuous production deployment.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fca5a5;fontFamily=Helvetica;fontSize=12;arcSize=8;" vertex="1" parent="col_problem">
          <mxGeometry x="30" y="50" width="420" height="70" as="geometry"/>
        </mxCell>

        <!-- Prob 01: Silent Covariate Drift -->
        <mxCell id="p_01" value="&lt;b&gt;Silent Covariate Drift &amp;amp; Decay&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;color:#64748b;'&gt;Live customer behavior shifts, causing accuracy to collapse silently. Engineering teams only discover decay weeks late after revenue loss.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;fontColor=#1e293b;arcSize=8;" vertex="1" parent="col_problem">
          <mxGeometry x="30" y="150" width="420" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="b_p_01" value="01" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dc2626;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="col_problem">
          <mxGeometry x="20" y="140" width="24" height="24" as="geometry"/>
        </mxCell>

        <!-- Prob 02: Notebook to Prod Chasm -->
        <mxCell id="p_02" value="&lt;b&gt;Notebook-to-Production Chasm&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;color:#64748b;'&gt;Data scientists build models in Jupyter Notebooks. Productionizing takes 4 to 8 weeks of manual rewriting, Dockerfile debugging, and dependency hell.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;fontColor=#1e293b;arcSize=8;" vertex="1" parent="col_problem">
          <mxGeometry x="30" y="280" width="420" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="b_p_02" value="02" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dc2626;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="col_problem">
          <mxGeometry x="20" y="270" width="24" height="24" as="geometry"/>
        </mxCell>

        <!-- Prob 03: Fragile Tooling Fragmentation -->
        <mxCell id="p_03" value="&lt;b&gt;Fragile Tooling Fragmentation&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;color:#64748b;'&gt;Engineers juggle 7 disconnected systems (Grafana, DVC, terminal logs, Azure Portal, MLflow, Git). Zero single source of truth.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;fontColor=#1e293b;arcSize=8;" vertex="1" parent="col_problem">
          <mxGeometry x="30" y="410" width="420" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="b_p_03" value="03" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dc2626;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="col_problem">
          <mxGeometry x="20" y="400" width="24" height="24" as="geometry"/>
        </mxCell>

        <!-- Prob 04: Zero Automated Gating & Security Leaks -->
        <mxCell id="p_04" value="&lt;b&gt;Zero Quality Gating &amp;amp; Security Risks&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;color:#64748b;'&gt;Inferior models get promoted without p95 latency checks. Credentials and storage connection strings leak inside container images.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;fontColor=#1e293b;arcSize=8;" vertex="1" parent="col_problem">
          <mxGeometry x="30" y="540" width="420" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="b_p_04" value="04" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dc2626;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="col_problem">
          <mxGeometry x="20" y="530" width="24" height="24" as="geometry"/>
        </mxCell>


        <!-- COLUMN 2: HOW WE ARE SOLVING IT -->
        <mxCell id="col_solution" value="2. HOW WE ARE SOLVING IT: AUTONOMOUS MULTI-AGENT STATEGRAPH" style="swimlane;html=1;startSize=32;rounded=1;arcSize=6;fillColor=#eff6ff;strokeColor=#93c5fd;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#1e40af;" vertex="1" parent="1">
          <mxGeometry x="580" y="50" width="530" height="980" as="geometry"/>
        </mxCell>

        <!-- Solution Banner -->
        <mxCell id="card_sol_banner" value="&lt;b style='font-size:14px;color:#2563eb;'&gt;Plug &amp;amp; Play Multi-Agent State Machine&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;color:#1e3a8a;'&gt;LangGraph State Coordination | LangSmith Telemetry | Azure Cloud Runtime&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bfdbfe;fontFamily=Helvetica;fontSize=12;arcSize=8;" vertex="1" parent="col_solution">
          <mxGeometry x="30" y="50" width="470" height="70" as="geometry"/>
        </mxCell>

        <!-- Sol 05: Data Sentinel -->
        <mxCell id="s_05" value="&lt;b&gt;Data Sentinel Agent (Drift Firewall)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;color:#475569;'&gt;Automated 2-sample Kolmogorov-Smirnov test &amp;amp; Laplace-smoothed 10-bin Population Stability Index (PSI). Detects dirty data before training.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;fontColor=#1e293b;arcSize=8;" vertex="1" parent="col_solution">
          <mxGeometry x="30" y="150" width="470" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="b_s_05" value="05" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2563eb;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="col_solution">
          <mxGeometry x="20" y="140" width="24" height="24" as="geometry"/>
        </mxCell>

        <!-- Sol 06: Training & HP Agent -->
        <mxCell id="s_06" value="&lt;b&gt;Training &amp;amp; Hyperparameter Agent&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;color:#475569;'&gt;Trains candidate models (LightGBM, XGBoost, PyTorch) with stratified cross-validation, parameter bounding, and instant serialization (.pkl/.onnx).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;fontColor=#1e293b;arcSize=8;" vertex="1" parent="col_solution">
          <mxGeometry x="30" y="260" width="470" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="b_s_06" value="06" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2563eb;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="col_solution">
          <mxGeometry x="20" y="250" width="24" height="24" as="geometry"/>
        </mxCell>

        <!-- Sol 07: Eval Gate Agent -->
        <mxCell id="s_07" value="&lt;b&gt;Evaluation Gate Agent (Champion vs Challenger)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;color:#475569;'&gt;Automated regression firewall: requires F1(cand) &gt;= F1(champ) and benchmarks 150 batch inferences against strict p95 latency budget.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;fontColor=#1e293b;arcSize=8;" vertex="1" parent="col_solution">
          <mxGeometry x="30" y="370" width="470" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="b_s_07" value="07" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#059669;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="col_solution">
          <mxGeometry x="20" y="360" width="24" height="24" as="geometry"/>
        </mxCell>

        <!-- Sol 08: AgentShield Security Sentinel -->
        <mxCell id="s_08" value="&lt;b&gt;AgentShield Security Sentinel&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;color:#475569;'&gt;Static Shannon entropy &amp;amp; regex scanner audits code for zero exposed secrets. Mandates Azure Managed Identity &amp;amp; non-root Docker user.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;fontColor=#1e293b;arcSize=8;" vertex="1" parent="col_solution">
          <mxGeometry x="30" y="480" width="470" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="b_s_08" value="08" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dc2626;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="col_solution">
          <mxGeometry x="20" y="470" width="24" height="24" as="geometry"/>
        </mxCell>

        <!-- Sol 09: Human-in-the-Loop Sovereign Gate -->
        <mxCell id="s_09" value="&lt;b&gt;Human-in-the-Loop (HITL) Checkpoint&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px;color:#475569;'&gt;LangGraph StateGraph halts before production rollout. Lead engineer reviews candidate metrics &amp;amp; security pass before signing off.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;fontColor=#1e293b;arcSize=8;" vertex="1" parent="col_solution">
          <mxGeometry x="30" y="590" width="470" height="85" as="geometry"/>
